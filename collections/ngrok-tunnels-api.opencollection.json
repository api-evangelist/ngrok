{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ngrok Abuse Reports Tunnels API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tunnels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ngrok List Tunnels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ngrok.com/tunnels",
            "params": [
              {
                "name": "before_id",
                "value": "",
                "type": "query",
                "description": "An ID to use for pagination. Results returned will be before this ID."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of results to return. Maximum is 100."
              }
            ]
          },
          "docs": "List all online tunnels currently running on the account."
        },
        {
          "info": {
            "name": "Ngrok Get Tunnel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ngrok.com/tunnels/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique identifier for the resource."
              }
            ]
          },
          "docs": "Get the details of a tunnel by ID."
        }
      ]
    }
  ],
  "bundled": true
}