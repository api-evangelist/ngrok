  "info": {
    "_postman_id": "38bce4b4-71cf-4701-923a-1df77514f929",
    "name": "Ngrok Abuse Reports Endpoints API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The ngrok API provides programmatic access to all of ngrok's resources. The API is REST-ish. It follows most of the conventions of a REST API but diverges slightly when the REST model does not fit well. The API listens only on port 443 to help avoid any accidental unencrypted requests. All API access requires an API key.\n\nContact Support:\n Name: Ngrok",
      "type": "text/plain"
    }
  }
